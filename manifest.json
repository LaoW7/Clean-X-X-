{
  "manifest_version": 3,
  "name": "清简 X",
  "version": "1.0.9",
  "description": "精简 X 的导航和侧栏，让时间线以文字为主。",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "清简 X",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["content.css", "work-mode.css"],
      "js": ["settings.js", "timeline-position.js", "media-thumbnails.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
